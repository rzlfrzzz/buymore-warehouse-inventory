# Docker Compose reads .env; Node scripts use shell environment (no automatic dotenv).
POSTGRES_PASSWORD=replace-with-local-password
# URL-encode the password. PostgreSQL is the default backend.
DATABASE_URL=postgresql://buymore:replace-with-local-password@127.0.0.1:5432/buymore
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Explicit local development alternative only, never production:
# DB_MODE=pglite
# PGLITE_PATH=./.data/warehouse
# Explicit seed only; choose your own 12+ character development password:
# DEV_SEED=true
# DEV_SEED_PASSWORD=replace-with-your-development-password
# Production: NODE_ENV=production, HTTPS APP_ORIGIN, same-origin HTTPS reverse proxy.
